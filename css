/* ============================
   Finance Portal Styles
   ============================ */

:root {
  --primary: #0b7a75;
  --secondary: #f4b942;
  --dark: #1f2933;
  --light: #f5f7fa;
  --text: #344054;
  --muted: #667085;
  --success: #16a34a;
  --danger: #dc2626;
  --border: #dfe3e8;
  --shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  --radius: 12px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #f4f7fb 0%, #edf3f7 100%);
  color: var(--text);
  line-height: 1.6;
}

header {
  background: linear-gradient(135deg, var(--dark), #233a4f);
  color: #fff;
  padding: 18px 24px;
  box-shadow: var(--shadow);
}

header h1 {
  margin-bottom: 16px;
  font-size: clamp(2rem, 4vw, 2.8rem);
  color: #fff;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 18px;
}

nav a {
  color: #fff;
  text-decoration: none;
  font-weight: 600;
  opacity: 0.95;
}

nav a:hover {
  opacity: 1;
  text-decoration: underline;
}

main,
section {
  padding: 30px 24px;
  max-width: 1100px;
  margin: 0 auto;
}

h2 {
  margin-bottom: 20px;
  color: var(--dark);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

p {
  margin-bottom: 18px;
  color: var(--muted);
}

label {
  display: block;
  margin-bottom: 12px;
  font-weight: 700;
  color: var(--dark);
}

input,
button,
select,
textarea {
  font: inherit;
}

input {
  width: 100%;
  max-width: 420px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-top: 8px;
  background: #fff;
}

input:focus,
select:focus,
textarea:focus {
  outline: 2px solid rgba(11, 122, 117, 0.18);
  border-color: var(--primary);
}

button {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 12px 22px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
  margin-top: 10px;
}

button:hover {
  transform: translateY(-1px);
  opacity: 0.96;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}

th,
td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

th {
  background: #f8fafc;
  color: var(--dark);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

tr:last-child td {
  border-bottom: none;
}

ul {
  padding-left: 22px;
  color: var(--text);
}

li {
  margin-bottom: 10px;
}

footer {
  background: var(--dark);
  color: rgba(255, 255, 255, 0.85);
  padding: 18px 24px;
  text-align: center;
  margin-top: 40px;
}

#result,
#conversion {
  margin-top: 18px;
  font-weight: 700;
  color: var(--dark);
}

@media (max-width: 640px) {
  header,
  main,
  section,
  footer {
    padding-left: 16px;
    padding-right: 16px;
  }

  nav {
    flex-direction: column;
    align-items: flex-start;
  }

  input {
    max-width: 100%;
  }
}
