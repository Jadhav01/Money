/* ============================
   Finance Portal Styles
   ============================ */

:root {
  --primary: #0b7a75;
  --secondary: #f4b942;
  --dark: #1f2933;
  --light: #f5f7fa;
  --text: #344054;
  --muted: #667085;
  --success: #16a34a;
  --danger: #dc2626;
  --border: #dfe3e8;
  --shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  --radius: 12px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #f4f7fb 0%, #edf3f7 100%);
  color: var(--text);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: var(--primary);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

.container {
  width: min(1200px, 92%);
  margin: 0 auto;
}

header {
  background: linear-gradient(135deg, var(--dark), #233a4f);
  color: white;
  padding: 18px 0;
  box-shadow: var(--shadow);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  font-size: 1.7rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.nav-links a {
  color: white;
  opacity: 0.9;
  font-weight: 600;
}

.nav-links a:hover {
  opacity: 1;
  text-decoration: none;
}

.hero {
  padding: 80px 0 60px;
}

.hero-content {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 40px;
}

.hero h1 {
  font-size: clamp(2rem, 5vw, 3.3rem);
  line-height: 1.15;
  margin-bottom: 18px;
  color: var(--dark);
}

.hero p {
  font-size: 1.08rem;
  color: var(--muted);
  max-width: 620px;
  margin-bottom: 26px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 22px;
  border-radius: 999px;
  border: 1px solid transparent;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
  text-decoration: none;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: var(--dark);
  border-color: var(--border);
}

.hero-card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 26px;
  border: 1px solid rgba(15, 23, 42, 0.04);
}

.card-balance {
  font-size: 0.85rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.balance-value {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: var(--dark);
  margin: 10px 0 18px;
}

.mini-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr));
  gap: 14px;
}

.stat-box {
  background: var(--light);
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--border);
}

.stat-box small {
  display: block;
  color: var(--muted);
  margin-bottom: 4px;
}

.stat-box strong {
  font-size: 1.1rem;
  color: var(--dark);
}

.section {
  padding: 40px 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
  gap: 15px;
}

.section-header h2 {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--dark);
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 22px;
}

.info-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 22px;
}

.info-card .icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: rgba(11, 122, 117, 0.1);
  color: var(--primary);
  font-weight: 700;
  margin-bottom: 18px;
}

.info-card h3 {
  font-size: 1.2rem;
  color: var(--dark);
  margin-bottom: 8px;
}

.info-card p {
  color: var(--muted);
}

.table-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.table-card table {
  width: 100%;
  border-collapse: collapse;
}

.table-card th,
.table-card td {
  text-align: left;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border);
}

.table-card th {
  background: #f8fafc;
  color: var(--dark);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.badge {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
}

.badge.success {
  background: rgba(22, 163, 74, 0.12);
  color: var(--success);
}

.badge.warning {
  background: rgba(244, 185, 66, 0.14);
  color: #b7791f;
}

.badge.danger {
  background: rgba(220, 38, 38, 0.1);
  color: var(--danger);
}

.form-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 18px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label {
  font-weight: 700;
  color: var(--dark);
}

.field input,
.field select,
.field textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  font: inherit;
  background: #fff;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  outline: 2px solid rgba(11, 122, 117, 0.18);
  border-color: var(--primary);
}

textarea {
  min-height: 120px;
  resize: vertical;
}

footer {
  background: var(--dark);
  color: rgba(255,255,255,0.85);
  padding: 22px 0;
  margin-top: 40px;
}

.footer-wrap {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

@media (max-width: 900px) {
  .hero-content,
  .cards-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .navbar,
  .section-header,
  .footer-wrap {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 560px) {
  .hero {
    padding-top: 56px;
  }

  .nav-links {
    gap: 10px 16px;
  }

  .btn {
    width: 100%;
  }

  .hero-actions {
    flex-direction: column;
  }
}
